<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Контейнер для названия (центрируется программно) -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView style="@style/BrickLetter" android:text="A" />
        <TextView style="@style/BrickLetter" android:text="R" />
        <TextView style="@style/BrickLetter" android:text="K" />
        <TextView style="@style/BrickLetter" android:text="A" />
        <TextView style="@style/BrickLetter" android:text="N" />
        <TextView style="@style/BrickLetter" android:text="O" />
        <TextView style="@style/BrickLetter" android:text="I" />
        <TextView style="@style/BrickLetter" android:text="D" />
    </LinearLayout>

    <!-- Растягиваемся, чтобы кнопки были в центре -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Горизонтальный контейнер для двух кнопок -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Кнопка Новая игра (старт) -->
        <LinearLayout
            android:id="@+id/startContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="20dp">

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_play_triangle"
                android:backgroundTint="#4CAF50"
                android:contentDescription="@string/start_game" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_game"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Кнопка Продолжить (будет видна только при наличии сохранения) -->
        <LinearLayout
            android:id="@+id/continueContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/buttonContinue"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_replay_circle"
                android:backgroundTint="#2196F3"
                android:contentDescription="@string/continue_game" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continue_game"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Подпись под кнопками (уже внутри контейнеров, поэтому этот TextView не нужен) -->

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Нижняя панель достижений -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="#00000000">

        <TextView
            android:id="@+id/textViewMaxLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/max_level_default"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textViewRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/record_default"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>